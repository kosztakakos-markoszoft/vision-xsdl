{
  "name": "vision-xsdl",
  "displayName": "Vision XSDL",
  "description": "XSDL language support for Vision X10",
  "publisher": "kosztak",
  "icon": "icon.png",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "xsdl",
    "vision x",
    "scada",
    "plc"
  ],
  "author": {
    "name": "Koszták Ákos",
    "email": "kosztak.akos@markoszoft.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kosztakakos-markoszoft/vision-xsdl.git"
  },
  "bugs": {
    "url": "https://github.com/kosztakakos-markoszoft/vision-xsdl/issues"
  },
  "homepage": "https://github.com/kosztakakos-markoszoft/vision-xsdl#readme",
  "license": "MIT",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "activationEvents": [
    "onLanguage:xsdl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xsdl",
        "aliases": [
          "XSDL",
          "xsdl"
        ],
        "extensions": [
          ".xsdl",
          ".val"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xsdl",
        "scopeName": "source.xsdl",
        "path": "./syntaxes/xsdl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "xsdl",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "dependencies": {
    "@types/vscode": "^1.136.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0"
  }
}
