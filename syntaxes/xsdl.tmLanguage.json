{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XSDL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#blocks" },
    { "include": "#types" },
    { "include": "#booleans" },
    { "include": "#special_constants" },
    { "include": "#at_references" },
    { "include": "#variable_declarations" },
    { "include": "#numbers" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.xsdl",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.xsdl",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xsdl",
          "match": "\\\\."
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z0-9_]+)\\s*=",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.xsdl"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xsdl",
          "match": "(?i)\\b(if|then|else|while|do|for|to|downto|repeat|until|case|of|function|Procedure|type|object|property)\\b"
        },
        {
          "name": "keyword.operator.xsdl",
          "match": "(?i)\\b(and|or|not|mod|div|inc|dec)\\b"
        },
        {
          "name": "support.class.xsdl",
          "match": "(?i)\\b(Constants|Shortints|Bytes|Integers|Words|Longints|DWords|DLongs|ScaledReals|S5Times|BCDs|ShortintTrends|ByteTrends|IntegerTrends|WordTrends|LongintTrends|DWordTrends|DLongTrends|ScaledRealTrends|BCDTrends|DirectShortints|DirectBytes|DirectIntegers|DirectWords|DirectLongints|DirectDWords|DirectDLongs|BCDWords|Reals|Doubles|RealTrends|DoubleTrends|Discretes|Morestates|Messages|WideStrings|LongStrings|PackTimes|LongTimes|IODevices)\\b"
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "keyword.control.block.xsdl",
          "match": "(?i)\\b(BEGIN|END|DO|STATIC)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.xsdl",
          "match": "(?i)\\b(ushort|shortstring|bool|dword|double|namestring|XNumerics|XDigits)\\b"
        },
        {
          "name": "support.type.xsdl",
          "match": "(?i)\\b(Image|Driver|Node|TcpSocket|UdpSocket|Input|Output|Communication)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.xsdl",
          "match": "(?i)\\b(true|false)\\b"
        }
      ]
    },
    "special_constants": {
      "patterns": [
        {
          "name": "support.constant.xsdl",
          "match": "(?i)\\b(DNONE|WNONE)\\b"
        }
      ]
    },
    "at_references": {
      "patterns": [
        {
          "name": "variable.parameter.reference.xsdl",
          "match": "@[a-zA-Z0-9_]+"
        }
      ]
    },
    "variable_declarations": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z0-9_\\.]+)\\s*:",
          "captures": {
            "1": {
              "name": "variable.name.declaration.xsdl"
            }
          }
        },
        {
          "match": "#(fun|pub|lib)\\s+([a-zA-Z0-9_]+)",
          "captures": {
            "1": { "name": "keyword.control.directive.xsdl" },
            "2": { "name": "entity.name.namespace.xsdl" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xsdl",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.xsdl",
          "match": "\\$[0-9A-Fa-f]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.xsdl" }
          }
        },
        {
          "name": "variable.other.object.xsdl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)+\\b"
        },
        {
          "name": "variable.other.xsdl",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.xsdl"
}